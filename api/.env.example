# Server Configuration
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb://localhost:27017/advancia

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=7d

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=noreply@advancia.com

# Executive Emails (comma-separated)
EXECUTIVE_EMAILS=executive1@advancia.com,executive2@advancia.com

# Cron Schedule (default: daily at 9 AM)
CRON_SCHEDULE=0 9 * * *
