# Local API development defaults. Do not commit a populated .env file.
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb://localhost:27017/advancia

# Authentication — replace with a long random value outside local development.
JWT_SECRET=local-development-only-replace-before-hosting
JWT_EXPIRATION=7d

# Email is disabled when credentials are empty.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=noreply@example.invalid

# Executive Emails (comma-separated)
EXECUTIVE_EMAILS=

# Cron Schedule (default: daily at 9 AM)
CRON_SCHEDULE=0 9 * * *
