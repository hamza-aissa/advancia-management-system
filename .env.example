# Local/demo Compose settings. Copy this file to .env before starting the stack.
# Never reuse these example values for an internet-facing deployment.
COMPOSE_PROJECT_NAME=advancia-demo

API_PORT=5000
WEB_PORT=8080
MONGO_DATABASE=advancia
JWT_SECRET=local-demo-only-replace-with-a-long-random-secret-before-hosting
JWT_EXPIRATION=7d
CRON_SCHEDULE=0 9 * * *
CRON_TIMEZONE=Africa/Tunis

# Browser requests stay same-origin at /api. Nginx resolves this internal target
# at runtime, so the browser never needs the private Docker hostname.
VITE_API_URL=/api
API_UPSTREAM=api:5000

# Docker uses Mailpit by default so reminder delivery is testable at localhost:8025.
# Replace these values with the organisation SMTP service when hosting.
MAILPIT_PORT=8025
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=Advancia <rappels@advancia.local>
EXECUTIVE_EMAILS=
